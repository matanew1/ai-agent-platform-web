# Every VITE_* value is embedded in the browser bundle. Never put a WorkOS
# API key, client secret, cookie password, or any other server-side secret
# in this file - authentication is entirely backend-owned now (see the
# ai-agent-platform repo's modules/authentication), so this frontend has no
# WorkOS-facing config of its own at all. Sign-in/sign-up/sign-out are plain
# navigations to the backend's own /auth/login, /auth/login?screen_hint=
# sign-up, /auth/logout - see src/features/auth/components/AuthGate.tsx.

# Backend API origin, without a trailing slash.
VITE_API_URL=http://localhost:8000
